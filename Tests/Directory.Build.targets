<Project>
  
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <VSTestResultsDirectory>Artifacts\TestResults</VSTestResultsDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="coverlet.MTP" Version="10.1.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <Using Include="Xunit" />
  </ItemGroup>

  <Import Project="..\Directory.Build.targets" />
  
</Project>
