{
  "platformOptions": {
    "Coverlet": {
      "format": "cobertura",
      "include": "[Tycho]*,[Tycho.Persistence.EFCore]*,[Tycho.Utils.SourceGenerator]*",
      "exclude": "[*.*Tests]*,[Tycho.Utils.SourceGenerator]Scriban*",
      "excludeByFile": "**/LoggerMessage.g.cs",
      "excludeByAttribute": "ExcludeFromCodeCoverageAttribute",
      "includeTestAssembly": false,
      "skipAutoProps": true,
      "deterministicReport": true,
      "useSourceLink": true
    }
  }
}
