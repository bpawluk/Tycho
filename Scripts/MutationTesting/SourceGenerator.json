{
  "stryker-config": {
    "project": "Tycho.Utils.SourceGenerator.csproj",
    "test-projects": [
      "../Tycho.Utils.SourceGenerator.UnitTests/Tycho.Utils.SourceGenerator.UnitTests.csproj",
      "../Tests/Tycho.Utils.SourceGenerator.IntegrationTests/Tycho.Utils.SourceGenerator.IntegrationTests.csproj"
    ],
    "test-runner": "mtp",
    "mutation-level": "Standard",
    "mutate": ["**/*.cs", "!**/*.g.cs", "!**/obj/**", "!**/bin/**", "!**/Scriban/**", "!**/scriban/**"],
    "reporters": ["html", "json", "progress", "cleartext"],
    "thresholds": { "high": 80, "low": 60, "break": 0 },
    "break-on-initial-test-failure": true
  }
}
