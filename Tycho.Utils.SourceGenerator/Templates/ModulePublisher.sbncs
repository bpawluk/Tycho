{{~#--------- Calculate indentation ---------#~}}
{{~ ns_offset = namespace != "" ? 1 : 0 ~}}
{{~ ct_count = array.size containing_types ~}}
{{~ bi = ns_offset + ct_count ~}}
{{~ i0 = string.pad_left "" (bi * 4) ~}}
{{~ i1 = string.pad_left "" ((bi + 1) * 4) ~}}
{{~ i2 = string.pad_left "" ((bi + 2) * 4) ~}}
{{~#-----------------------------------------#~}}
{{~#--------- Write used namespaces ---------#~}}
{{~ for used_namespace in used_namespaces ~}}
using {{ used_namespace }};
{{ end }}
{{~#-----------------------------------------#~}}
{{~#----------- Declare namespace -----------#~}}
{{~ if namespace != "" ~}}
namespace {{ namespace }}
{
{{~ end ~}}
{{~#-----------------------------------------#~}}
{{~#---------- Declare outer types ----------#~}}
{{~ for containing_type in containing_types ~}}
{{ string.pad_left "" ((ns_offset + for.index) * 4) }}{{ containing_type }}
{{ string.pad_left "" ((ns_offset + for.index) * 4) }}{
{{~ end ~}}
{{~#-----------------------------------------#~}}
{{~#------------------------------------------------- MODULE PUBLISHER -------------------------------------------------#~}}
{{ i0 }}internal class {{ classes.publisher_class_with_type_params }} : {{ classes.publisher_base_class }}, {{ classes.module_class }}.{{ interfaces.publisher_interface }}
{{~ for owner_constraint in owner_constraints ~}}
{{   i1   }}{{ owner_constraint }}
{{~ end ~}}
{{ i0 }}{
{{   i1   }}public {{ classes.publisher_class }}({{ classes.generic_publisher_class }} {{ parameters.generic_publisher_parameter }}) : base({{ parameters.generic_publisher_parameter }}) { }
{{~ for event in events ~}}

{{   i1   }}public {{ classes.task_class }} {{ methods.publish_async_method }}({{ event }} {{ parameters.event_payload_parameter }}, {{ classes.cancellation_token_class }} {{ parameters.cancellation_token_parameter }})
{{   i1   }}{
{{     i2     }}return {{ methods.publish_async_method }}<{{ event }}>({{ parameters.event_payload_parameter }}, {{ parameters.cancellation_token_parameter }});
{{   i1   }}}
{{~ end ~}}
{{ i0 }}}
{{~#--------------------------------------------------------------------------------------------------------------------#~}}
{{~#------- Close outer type brackets -------#~}}
{{~ for containing_type in containing_types ~}}
{{ string.pad_left "" ((bi - 1 - for.index) * 4) }}}
{{~ end ~}}
{{~#-----------------------------------------#~}}
{{~#-------- Close namespace bracket --------#~}}
{{~ if namespace != "" ~}}
}
{{~ end ~}}
{{~#-----------------------------------------#~}}
