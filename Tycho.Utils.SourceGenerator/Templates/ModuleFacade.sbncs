{{~ for used_namespace in used_namespaces ~}}
using {{ used_namespace }};
{{~ end ~}}

{{~ if namespace != "" ~}}
namespace {{ namespace }}
{
{{~ end ~}}
{{~ for containing_type in containing_types ~}}
    public partial class {{ containing_type }}
    {
{{~ end ~}}
    public interface {{ interfaces.module_interface }} : {{ interfaces.async_disposable_interface }}
    {
        {{~ for request in requests ~}}
        {{ classes.task_class }}{{ if request.has_response }}<{{ request.response_type }}>{{ end }} {{ symbols.execute_async_method }}({{ request.request_type }} {{ symbols.request_data_parameter }}, {{ structs.cancellation_token_struct }} {{ symbols.cancellation_token_parameter }} = default);
        
        {{~ end ~}}
    }

    public class {{ classes.facade_class }} : {{ interfaces.module_interface }}
    {
        private readonly {{ interfaces.instance_interface }} {{ symbols.module_field }};

        public {{ classes.facade_class }}({{ interfaces.instance_interface }} {{ symbols.module_parameter }})
        {
            {{ symbols.module_field }} = {{ symbols.module_parameter }};
        }

        {{~ for request in requests ~}}
        public {{ classes.task_class }}{{ if request.has_response }}<{{ request.response_type }}>{{ end }} {{ symbols.execute_async_method }}({{ request.request_type }} {{ symbols.request_data_parameter }}, {{ structs.cancellation_token_struct }} {{ symbols.cancellation_token_parameter }})
        {
            return {{ symbols.module_field }}.{{ methods.execute_async_method }}<{{ request.request_type }}{{ if request.has_response }}, {{ request.response_type }}{{ end }}>({{ symbols.request_data_parameter }}, {{ symbols.cancellation_token_parameter }});
        }
        
        {{~ end ~}}
        public async {{ classes.value_task_class }} {{ symbols.dispose_async_method }}()
        {
            await {{ symbols.module_field }}.{{ methods.dispose_async_method }}().{{ methods.configure_await_method }}(false);
        }
    }
{{~ for containing_type in containing_types ~}}
    }
{{~ end ~}}
{{~ if namespace != "" ~}}
}
{{~ end ~}}
