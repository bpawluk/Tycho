{{~#--------- Calculate indentation ---------#~}}
{{~ ns_offset = namespace != "" ? 1 : 0 ~}}
{{~ ct_count = array.size containing_types ~}}
{{~ bi = ns_offset + ct_count ~}}
{{~ i0 = string.pad_left "" (bi * 4) ~}}
{{~ i1 = string.pad_left "" ((bi + 1) * 4) ~}}
{{~#-----------------------------------------#~}}
{{~#--------- Write used namespaces ---------#~}}
{{~ for used_namespace in used_namespaces ~}}
using {{ used_namespace }};
{{ end }}
{{~#-----------------------------------------#~}}
{{~#----------- Declare namespace -----------#~}}
{{~ if namespace != "" ~}}
namespace {{ namespace }}
{
{{~ end ~}}
{{~#-----------------------------------------#~}}
{{~#---------- Declare outer types ----------#~}}
{{~ for containing_type in containing_types ~}}
{{ string.pad_left "" ((ns_offset + for.index) * 4) }}{{ containing_type }}
{{ string.pad_left "" ((ns_offset + for.index) * 4) }}{
{{~ end ~}}
{{~#-----------------------------------------#~}}
{{~#----------------------------------------------- APP FACADE INTERFACE -----------------------------------------------#~}}
{{ i0 }}public interface {{ interfaces.facade_interface }} : {{ interfaces.async_disposable_interface }}
{{~ for owner_constraint in owner_constraints ~}}
{{   i1   }}{{ owner_constraint }}
{{~ end ~}}
{{ i0 }}{
{{~ for request in requests ~}}
{{   i1   }}{{ classes.task_class }}{{ if request.has_response }}<{{ request.response_type }}>{{ end }} {{ methods.execute_async_method }}({{ request.request_type }} {{ parameters.request_data_parameter }}, {{ classes.cancellation_token_class }} {{ parameters.cancellation_token_parameter }} = default);
{{~ if !for.last ~}}

{{~ end ~}}
{{~ end ~}}
{{ i0 }}}
{{~#--------------------------------------------------------------------------------------------------------------------#~}}
{{~#------- Close outer type brackets -------#~}}
{{~ for containing_type in containing_types ~}}
{{ string.pad_left "" ((bi - 1 - for.index) * 4) }}}
{{~ end ~}}
{{~#-----------------------------------------#~}}
{{~#-------- Close namespace bracket --------#~}}
{{~ if namespace != "" ~}}
}
{{~ end ~}}
{{~#-----------------------------------------#~}}
