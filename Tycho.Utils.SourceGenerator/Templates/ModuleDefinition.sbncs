{{~ for used_namespace in used_namespaces ~}}
using {{ used_namespace }};
{{~ end ~}}

{{~ if namespace != "" ~}}
namespace {{ namespace }}
{
{{~ end ~}}
{{~ for containing_type in containing_types ~}}
    public partial class {{ containing_type }}
    {
{{~ end ~}}
    public partial class {{ classes.module_class }} : {{ classes.base_class }}
    {
        protected override void {{ methods.auto_setup_method }}({{ interfaces.service_collection_interface }} {{ parameters.module_parameter }})
        {
            {{ classes.service_collection_service_extensions_class }}.{{ methods.add_transient_method }}<{{ interfaces.event_handling_dispatcher_interface }}, {{ classes.event_dispatcher_class }}>({{ parameters.module_parameter }});
            {{~ for submodule in submodules ~}}
            {{ classes.service_collection_service_extensions_class }}.{{ methods.add_transient_method }}<{{ submodule.facade_interface }}>({{ parameters.module_parameter }}, {{ parameters.provider_parameter }} => new {{ submodule.facade_class }}({{ classes.service_provider_service_extensions_class }}.{{ methods.get_required_service_method }}<{{ interfaces.module_instance_interface }}<{{ submodule.module_class }}>>({{ parameters.provider_parameter }})));
            {{~ end ~}}
        }
    }
{{~ for containing_type in containing_types ~}}
    }
{{~ end ~}}
{{~ if namespace != "" ~}}
}
{{~ end ~}}
