        public static async global::System.Threading.Tasks.Task<global::Microsoft.Extensions.Hosting.IHostApplicationBuilder> Add{{ definition_type.type_name }}(this global::Microsoft.Extensions.Hosting.IHostApplicationBuilder builder, {{ definition_type.type_name }} app)
