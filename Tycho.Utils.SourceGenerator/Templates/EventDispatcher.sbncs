{{~ for used_namespace in used_namespaces ~}}
using {{ used_namespace }};
{{~ end ~}}

{{~ if namespace != "" ~}}
namespace {{ namespace }}
{
{{~ end ~}}
{{~ for containing_type in containing_types ~}}
    public partial class {{ containing_type }}
    {
{{~ end ~}}
    internal class {{ classes.event_dispatcher_class }} : {{ interfaces.event_handling_dispatcher_interface }}
    {
        private readonly {{ interfaces.payload_serializer_interface }} {{ symbols.payload_serializer_field }};

        public {{ classes.event_dispatcher_class }}({{ interfaces.payload_serializer_interface }} {{ symbols.payload_serializer_parameter }})
        {
            {{ symbols.payload_serializer_field }} = {{ symbols.payload_serializer_parameter }};
        }

        public async {{ classes.task_class }} {{ symbols.dispatch_method }}(
            {{ structs.guid_struct }} {{ symbols.event_id_parameter }},
            object {{ symbols.event_payload_parameter }},
            {{ interfaces.event_handler_interface }} {{ symbols.event_handler_parameter }},
            {{ structs.cancellation_token_struct }} {{ symbols.cancellation_token_parameter }})
        {
            switch ({{ symbols.event_handler_parameter }})
            {
            {{~ for event in events ~}}
                case {{ interfaces.event_handler_interface }}<{{ event }}> {{ symbols.cast_handler_variable }}:
                    await {{ symbols.dispatch_as_method }}({{ symbols.event_id_parameter }}, {{ symbols.event_payload_parameter }}, {{ symbols.cast_handler_variable }}, {{ symbols.cancellation_token_parameter }});
                    break;
            {{~ end ~}}
                default:
                    throw new {{ exceptions.invalid_operation_exception }}(
                        $"Missing handling logic for {{{ symbols.event_handler_parameter }}.{{ methods.get_type_method }}().{{ methods.full_name_property }}} event handler.");
            }
        }

        private async {{ classes.task_class }} {{ symbols.dispatch_as_method }}<{{ symbols.t_event_type_parameter }}>(
            {{ structs.guid_struct }} {{ symbols.event_id_parameter }},
            object {{ symbols.event_payload_parameter }},
            {{ interfaces.event_handler_interface }}<{{ symbols.t_event_type_parameter }}> {{ symbols.event_handler_parameter }},
            {{ structs.cancellation_token_struct }} {{ symbols.cancellation_token_parameter }})
            where {{ symbols.t_event_type_parameter }} : class, {{ interfaces.event_interface }}
        {
            var {{ symbols.deserialized_payload_variable }} = {{ symbols.payload_serializer_field }}.{{ methods.deserialize_method }}<{{ symbols.t_event_type_parameter }}>({{ symbols.event_payload_parameter }});
            var {{ symbols.context_variable }} = new {{ classes.event_context_class }}<{{ symbols.t_event_type_parameter }}>({{ symbols.event_id_parameter }}, {{ symbols.deserialized_payload_variable }});
            await {{ symbols.event_handler_parameter }}.{{ methods.handle_async_method }}({{ symbols.context_variable }}, {{ symbols.cancellation_token_parameter }});
        }
    }
{{~ for containing_type in containing_types ~}}
    }
{{~ end ~}}
{{~ if namespace != "" ~}}
}
{{~ end ~}}