{{~ for used_namespace in used_namespaces ~}}
using {{ used_namespace }};
{{~ end ~}}

{{~ if namespace != "" ~}}
namespace {{ namespace }}
{
{{~ end ~}}
{{~ for containing_type in containing_types ~}}
    public partial class {{ containing_type }}
    {
{{~ end ~}}
    internal class {{ classes.event_dispatcher_class }} : {{ interfaces.event_handling_dispatcher_interface }}
    {
        private readonly {{ interfaces.payload_serializer_interface }} _payloadSerializer;

        public {{ classes.event_dispatcher_class }}({{ interfaces.payload_serializer_interface }} {{ parameters.payload_serializer_parameter }})
        {
            _payloadSerializer = {{ parameters.payload_serializer_parameter }};
        }

        public async {{ classes.task_class }} {{ methods.dispatch_method }}(
            {{ classes.guid_class }} {{ parameters.event_id_parameter }},
            {{ classes.object_class }} {{ parameters.event_payload_parameter }},
            {{ interfaces.event_handler_interface }} {{ parameters.event_handler_parameter }},
            {{ classes.cancellation_token_class }} {{ parameters.cancellation_token_parameter }})
        {
            switch ({{ parameters.event_handler_parameter }})
            {
            {{~ for event in events ~}}
                case {{ interfaces.event_handler_interface }}<{{ event }}> castHandler:
                    await DispatchAs({{ parameters.event_id_parameter }}, {{ parameters.event_payload_parameter }}, castHandler, {{ parameters.cancellation_token_parameter }});
                    break;
            {{~ end ~}}
                default:
                    throw new {{ exceptions.invalid_operation_exception }}(
                        $"Missing handling logic for {{{ parameters.event_handler_parameter }}.{{ methods.get_type_method }}().{{ properties.full_name_property }}} event handler.");
            }
        }

        private async {{ classes.task_class }} DispatchAs<TEvent>(
            {{ classes.guid_class }} {{ parameters.event_id_parameter }},
            {{ classes.object_class }} {{ parameters.event_payload_parameter }},
            {{ interfaces.event_handler_interface }}<TEvent> {{ parameters.event_handler_parameter }},
            {{ classes.cancellation_token_class }} {{ parameters.cancellation_token_parameter }})
            where TEvent : class, {{ interfaces.event_interface }}
        {
            var deserializedPayload = _payloadSerializer.{{ methods.deserialize_method }}<TEvent>({{ parameters.event_payload_parameter }});
            var eventContext = new {{ classes.event_context_class }}<TEvent>({{ parameters.event_id_parameter }}, deserializedPayload);
            await {{ parameters.event_handler_parameter }}.{{ methods.handle_async_method }}(eventContext, {{ parameters.cancellation_token_parameter }});
        }
    }
{{~ for containing_type in containing_types ~}}
    }
{{~ end ~}}
{{~ if namespace != "" ~}}
}
{{~ end ~}}