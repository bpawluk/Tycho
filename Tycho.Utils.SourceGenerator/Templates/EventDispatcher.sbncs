{{~ for used_namespace in used_namespaces ~}}
using {{ used_namespace }};
{{~ end ~}}

{{~ if namespace != "" ~}}
namespace {{ namespace }}
{
{{~ end ~}}
{{~ for containing_type in containing_types ~}}
    public partial class {{ containing_type }}
    {
{{~ end ~}}
    internal class {{ classes.event_dispatcher_class }} : {{ classes.event_dispatcher_base_class }}
    {
        public {{ classes.event_dispatcher_class }}({{ interfaces.payload_serializer_interface }} {{ parameters.payload_serializer_parameter }}) : base({{ parameters.payload_serializer_parameter }}) {}

        public async override {{ classes.task_class }} {{ methods.dispatch_method }}(
            {{ classes.guid_class }} {{ parameters.event_id_parameter }},
            {{ classes.object_class }} {{ parameters.event_payload_parameter }},
            {{ interfaces.event_handler_interface }} {{ parameters.event_handler_parameter }},
            {{ classes.cancellation_token_class }} {{ parameters.cancellation_token_parameter }})
        {
            switch ({{ parameters.event_handler_parameter }})
            {
            {{~ for event in events ~}}
                case {{ interfaces.event_handler_interface }}<{{ event }}> castHandler:
                    await {{ methods.dispatch_as_method }}({{ parameters.event_id_parameter }}, {{ parameters.event_payload_parameter }}, castHandler, {{ parameters.cancellation_token_parameter }});
                    break;
            {{~ end ~}}
                default:
                    throw new {{ exceptions.invalid_operation_exception }}(
                        $"Missing handling logic for { {{ parameters.event_handler_parameter }}.{{ methods.get_type_method }}().{{ properties.full_name_property }} } event handler.");
            }
        }
    }
{{~ for containing_type in containing_types ~}}
    }
{{~ end ~}}
{{~ if namespace != "" ~}}
}
{{~ end ~}}