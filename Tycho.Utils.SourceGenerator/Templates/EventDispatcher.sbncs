{{~ for used_namespace in used_namespaces ~}}
using {{ used_namespace }};
{{~ end ~}}

{{~ if namespace != "" ~}}
namespace {{ namespace }}
{
{{~ end ~}}
{{~ for containing_type in containing_types ~}}
    public partial class {{ containing_type }}
    {
{{~ end ~}}
    internal class {{ classes.event_dispatcher_class }} : {{ interfaces.event_handling_dispatcher_interface }}
    {
        private readonly {{ interfaces.payload_serializer_interface }} _payloadSerializer;

        public {{ classes.event_dispatcher_class }}({{ interfaces.payload_serializer_interface }} payloadSerializer)
        {
            _payloadSerializer = payloadSerializer;
        }

        public async {{ classes.task_class }} Dispatch(
            {{ structs.guid_struct }} eventId,
            object eventPayload,
            {{ interfaces.event_handler_interface }} eventHandler,
            {{ structs.cancellation_token_struct }} cancellationToken)
        {
            switch (eventHandler)
            {
            {{~ for event in events ~}}
                case {{ interfaces.event_handler_interface }}<{{ event }}> castHandler:
                    await DispatchAs(eventId, eventPayload, castHandler, cancellationToken);
                    break;
            {{~ end ~}}
                default:
                    throw new {{ exceptions.invalid_operation_exception }}(
                        $"Missing handling logic for {eventHandler.GetType().FullName} event handler.");
            }
        }

        private async {{ classes.task_class }} DispatchAs<TEvent>(
            {{ structs.guid_struct }} eventId,
            object eventPayload,
            {{ interfaces.event_handler_interface }}<TEvent> eventHandler,
            {{ structs.cancellation_token_struct }} cancellationToken)
            where TEvent : class, {{ interfaces.event_interface }}
        {
            var deserializedPayload = _payloadSerializer.Deserialize<TEvent>(eventPayload);
            var context = new {{ classes.event_context_class }}<TEvent>(eventId, deserializedPayload);
            await eventHandler.HandleAsync(context, cancellationToken);
        }
    }
{{~ for containing_type in containing_types ~}}
    }
{{~ end ~}}
{{~ if namespace != "" ~}}
}
{{~ end ~}}