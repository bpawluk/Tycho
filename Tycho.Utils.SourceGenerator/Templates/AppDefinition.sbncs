{{~ for used_namespace in used_namespaces ~}}
using {{ used_namespace }};
{{~ end ~}}

{{~ if namespace != "" ~}}
namespace {{ namespace }}
{
{{~ end ~}}
{{~ for containing_type in containing_types ~}}
    public partial class {{ containing_type }}
    {
{{~ end ~}}
    public partial class {{ classes.app_class }} : {{ classes.base_class }}
    {
        /// <summary>
        /// Supplies global configuration for the application and its modules.
        /// </summary>
        /// <param name="{{ parameters.global_configuration_parameter }}">Configuration to be used</param>
        /// <returns>The current <see cref="{{ classes.app_class }}"/> instance.</returns>
        /// <exception cref="{{ exceptions.argument_null_exception }}"/>
        public {{ classes.app_class }} {{ methods.with_configuration_method }}({{ interfaces.configuration_interface }} {{ parameters.global_configuration_parameter }})
        {
            {{ methods.with_configuration_base_method }}({{ parameters.global_configuration_parameter }});
            return this;
        }

        /// <summary>
        /// Supplies logging setup for the application and its modules.
        /// </summary>
        /// <param name="{{ parameters.logging_setup_parameter }}">Logging setup to be used</param>
        /// <returns>The current <see cref="{{ classes.app_class }}"/> instance.</returns>
        /// <exception cref="{{ exceptions.argument_null_exception }}"/>
        public {{ classes.app_class }} {{ methods.with_logging_method }}({{ classes.action_class }}<{{ interfaces.logging_builder_interface }}> {{ parameters.logging_setup_parameter }})
        {
            {{ methods.with_logging_base_method }}({{ parameters.logging_setup_parameter }});
            return this;
        }

        /// <summary>
        /// Builds and runs the application according to the definition.
        /// </summary>
        /// <returns>A fresh and ready to use instance of the application</returns>
        /// <exception cref="{{ exceptions.invalid_operation_exception }}"/>
        public async {{ classes.task_class }}<{{ interfaces.facade_interface }}> {{ methods.run_async_method }}()
        {
            var appInstance = await {{ methods.run_base_method }}().{{ methods.configure_await_method }}(false);
            return new {{ classes.facade_class }}(appInstance);
        }

        protected override void {{ methods.auto_setup_method }}({{ interfaces.service_collection_interface }} {{ parameters.app_parameter }})
        {
            {{classes.service_collection_service_extensions_class}}.{{ methods.add_transient_method }}<{{ interfaces.event_dispatcher_interface }}, {{ classes.event_dispatcher_class }}>({{ parameters.app_parameter }});
            {{~ for submodule in submodules ~}}
            {{ classes.service_collection_service_extensions_class }}.{{ methods.add_transient_method }}<{{ submodule.facade_interface }}>({{ parameters.app_parameter }}, {{ parameters.provider_parameter }} => new {{ submodule.facade_class }}({{ classes.service_provider_service_extensions_class }}.{{ methods.get_required_service_method }}<{{ interfaces.module_instance_interface }}<{{ submodule.module_class }}>>({{ parameters.provider_parameter }})));
            {{~ end ~}}
        }
    }
{{~ for containing_type in containing_types ~}}
    }
{{~ end ~}}
{{~ if namespace != "" ~}}
}
{{~ end ~}}
