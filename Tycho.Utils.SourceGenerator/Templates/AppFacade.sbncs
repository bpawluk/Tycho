{{~ for used_namespace in used_namespaces ~}}
using {{ used_namespace }};
{{~ end ~}}

{{~ if namespace != "" ~}}
namespace {{ namespace }}
{
{{~ end ~}}
{{~ for containing_type in containing_types ~}}
    public partial class {{ containing_type }}
    {
{{~ end ~}}
    public interface {{ interfaces.app_interface }} : {{ interfaces.async_disposable_interface }}
    {
        {{~ for request in requests ~}}
        {{ classes.task_class }}{{ if request.has_response }}<{{ request.response_type }}>{{ end }} ExecuteAsync({{ request.request_type }} requestData, {{ structs.cancellation_token_struct }} cancellationToken = default);
        
        {{~ end ~}}
    }

    public class {{ classes.facade_class }} : {{ interfaces.app_interface }}
    {
        private readonly {{ interfaces.instance_interface }} _app;

        public {{ classes.facade_class }}({{ interfaces.instance_interface }} app) 
        {
            _app = app;
        }

        {{~ for request in requests ~}}
        public {{ classes.task_class }}{{ if request.has_response }}<{{ request.response_type }}>{{ end }} ExecuteAsync({{ request.request_type }} requestData, {{ structs.cancellation_token_struct }} cancellationToken)
        {
            return _app.ExecuteAsync<{{ request.request_type }}{{ if request.has_response }}, {{ request.response_type }}{{ end }}>(requestData, cancellationToken);
        }
        
        {{~ end ~}}
        public async {{ classes.value_task_class }} DisposeAsync()
        {
            await _app.DisposeAsync().ConfigureAwait(false);
        }
    }
{{~ for containing_type in containing_types ~}}
    }
{{~ end ~}}
{{~ if namespace != "" ~}}
}
{{~ end ~}}
