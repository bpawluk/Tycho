{{~#--------- Calculate indentation ---------#~}}
{{~ ns_offset = namespace != "" ? 1 : 0 ~}}
{{~ ct_count = array.size containing_types ~}}
{{~ bi = ns_offset + ct_count ~}}
{{~ i0 = string.pad_left "" (bi * 4) ~}}
{{~ i1 = string.pad_left "" ((bi + 1) * 4) ~}}
{{~ i2 = string.pad_left "" ((bi + 2) * 4) ~}}
{{~#-----------------------------------------#~}}
{{~#--------- Write used namespaces ---------#~}}
{{~ for used_namespace in used_namespaces ~}}
using {{ used_namespace }};
{{ end }}
{{~#-----------------------------------------#~}}
{{~#----------- Declare namespace -----------#~}}
{{~ if namespace != "" ~}}
namespace {{ namespace }}
{
{{~ end ~}}
{{~#-----------------------------------------#~}}
{{~#---------- Declare outer types ----------#~}}
{{~ for containing_type in containing_types ~}}
{{ string.pad_left "" ((ns_offset + for.index) * 4) }}public partial class {{ containing_type }}
{{ string.pad_left "" ((ns_offset + for.index) * 4) }}{
{{~ end ~}}
{{~#-----------------------------------------#~}}
{{~#-------------------------------------------------- MODULE PARENT --------------------------------------------------#~}}
{{ i0 }}internal class {{ classes.parent_class }} : {{ classes.parent_base_class }}, {{ classes.module_class }}.{{ interfaces.parent_interface }}
{{~ for owner_constraint in owner_constraints ~}}
{{   i1   }}{{ owner_constraint }}
{{~ end ~}}
{{ i0 }}{
{{   i1   }}public {{ classes.parent_class_name }}({{ classes.parent_reference_class }} {{ parameters.parent_reference_parameter }}) : base({{ parameters.parent_reference_parameter }}) { }
{{~ for request in requests ~}}

{{   i1   }}public {{ classes.task_class }}{{ if request.has_response }}<{{ request.response_type }}>{{ end }} {{ methods.execute_async_method }}({{ request.request_type }} {{ parameters.request_data_parameter }}, {{ classes.cancellation_token_class }} {{ parameters.cancellation_token_parameter }})
{{   i1   }}{
{{     i2     }}return {{ methods.execute_async_method }}<{{ request.request_type }}{{ if request.has_response }}, {{ request.response_type }}{{ end }}>({{ parameters.request_data_parameter }}, {{ parameters.cancellation_token_parameter }});
{{   i1   }}}
{{~ end ~}}
{{ i0 }}}
{{~#-------------------------------------------------------------------------------------------------------------------#~}}
{{~#------- Close outer type brackets -------#~}}
{{~ for containing_type in containing_types ~}}
{{ string.pad_left "" ((bi - 1 - for.index) * 4) }}}
{{~ end ~}}
{{~#-----------------------------------------#~}}
{{~#-------- Close namespace bracket --------#~}}
{{~ if namespace != "" ~}}
}
{{~ end ~}}
{{~#-----------------------------------------#~}}
