<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Build\Package.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <PackageTags>tycho; module; modular; architecture; framework</PackageTags>
    <Description>Lightweight framework for writing modular .NET apps</Description>
    <IncludeReferencedAnalyzers>true</IncludeReferencedAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tycho.Utils.SourceGenerator\Tycho.Utils.SourceGenerator.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Tycho.Utils.SourceGenerator\bin\$(Configuration)\netstandard2.0\Tycho.Utils.SourceGenerator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2, PublicKey=$(DynamicProxyPublicKey)</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tycho.Persistence.EFCore, PublicKey=$(TychoPublicKey)</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tycho.Persistence.EFCore.TestUtils, PublicKey=$(TychoPublicKey)</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tycho.Persistence.EFCore.UnitTests, PublicKey=$(TychoPublicKey)</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tycho.Persistence.EFCore.UseCaseTests, PublicKey=$(TychoPublicKey)</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tycho.UnitTests, PublicKey=$(TychoPublicKey)</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
